# ─────────────────────────────────────────────
# COPY THIS FILE TO .env AND FILL IN THE VALUES
# Never commit .env to GitHub
# ─────────────────────────────────────────────

# ── WhatsApp Cloud API (from Meta Developer Portal) ──
WHATSAPP_TOKEN=          # Permanent access token (System User token)
WHATSAPP_PHONE_ID=       # Your WhatsApp Phone Number ID
WEBHOOK_VERIFY_TOKEN=    # Any random string you choose e.g. clinic123abc

# ── Google Service Account ──
# Paste the ENTIRE contents of your service-account-key.json here as one line
# OR set GOOGLE_KEY_FILE to the path of the file
GOOGLE_SERVICE_ACCOUNT_EMAIL=   # e.g. bot@my-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY=              # The "private_key" value from your JSON key file

# ── Google Sheet IDs ──
# The ID is in the Google Sheet URL:
# https://docs.google.com/spreadsheets/d/SHEET_ID_HERE/edit
MASTER_SHEET_ID=         # Your master template sheet ID

# ── App Settings ──
PORT=3000
NODE_ENV=production
TIMEZONE=Asia/Singapore
